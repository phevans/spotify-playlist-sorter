VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Local dev. In production this is set in the Netlify dashboard to
# https://sps.djgibbon.co.uk/callback — both must be registered as
# Redirect URIs on the Spotify app.
VITE_REDIRECT_URI=http://127.0.0.1:5173/callback

# Musical key lookup (https://getsongbpm.com/api).
# Deliberately NOT VITE_-prefixed: it is read server-side by
# netlify/functions/songkey.mjs. Adding the VITE_ prefix would inline it
# into the public JS bundle. Requires `netlify dev` to be picked up locally.
GETSONGBPM_KEY=your_getsongbpm_api_key
